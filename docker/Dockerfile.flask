# Dockerfile for Python Flask Microservice
# Located under docker/ for centralized container orchestration

FROM python:3.12-slim

RUN useradd -m -r appuser && mkdir -p /app/data && chown -R appuser:appuser /app
WORKDIR /app

COPY flask-app/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY flask-app/app.py ./
RUN chown -R appuser:appuser /app

USER appuser

ENV PORT=5000
ENV FLASK_DB_PATH=/app/data/complaints_flask.db
ENV PYTHONUNBUFFERED=1

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:5000/health')" || exit 1

CMD ["python", "app.py"]
